APP_NAME=MedGraphRAG Platform
DEBUG=true

# ── LLM Configuration ──
# Options: "ollama" (local Qwen 2.5), "openrouter", "groq", "gemini"
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Cloud Fallback Keys (Optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct:free
GROQ_API_KEY=
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3-flash-preview

# ── Vector Store Configuration ──
# Options: "lancedb" (disk-native hybrid), "chroma"
VECTOR_STORE_BACKEND=lancedb
LANCEDB_DIR=data/lancedb

# ── Knowledge Graph Configuration ──
# Options: "kuzudb" (embedded Cypher property graph), "mock"
GRAPH_STORE_BACKEND=kuzudb
KUZU_DB_DIR=data/kuzudb

# ── Embeddings Configuration ──
# Options: "sentence-transformers/all-MiniLM-L6-v2" (fast English), "BAAI/bge-m3" (100+ languages)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ── Observability ──
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=MedGraphRAG
